OPENAI_API_KEY=你的OpenAI_API_Key
OPENAI_BASE_URL=https://your-proxy-domain/v1

OKX_API_KEY=你的OKX_API_Key
OKX_API_SECRET=你的OKX_API_Secret
OKX_API_PASSPHRASE=你的OKX_API_Passphrase

OPENAI_MODEL=gpt-5.5
BACKTEST_FILE=user_data/backtest_results/backtest-result.json
AI_ANALYSIS_FILE=user_data/backtest_results/ai-analysis.txt
AI_STRATEGY_FILE=user_data/strategies/AI_Generated_Strategy.py
# ========== AI 总开关 ==========
AI_MODEL_SWITCH_ON_ERROR=true
AI_MODEL_MAX_ATTEMPTS_PER_CALL=5
AI_MODEL_TIMEOUT_SECONDS=180
AI_CALL_COOLDOWN_SECONDS=10
ADVISOR_TO_CODEGEN_DELAY_SECONDS=5

# ========== 自动组装 Provider Pool ==========
# 推荐：不再手写 *_PROVIDER_POOL，由 AI_PROVIDER_<ID>_ENABLED / ROLE / PRIORITY_* 自动生成。
AUTO_BUILD_PROVIDER_POOLS=true
# 如需回退旧配置并手写 STRATEGY_ADVISOR_PROVIDER_POOL 等池，改为 true。
FORCE_PROVIDER_POOL_MANUAL=false

# 旧手写池仍兼容；仅当 AUTO_BUILD_PROVIDER_POOLS=false 或 FORCE_PROVIDER_POOL_MANUAL=true 时使用。
# MARKET_SEARCH_PROVIDER_POOL=openrouter_sonar_pro
# AI_COMMITTEE_ANALYST_PROVIDER_POOL=deepseek_official,glm_official
# STRATEGY_ADVISOR_PROVIDER_POOL=apihost_claude_opus47,deepseek_official
# STRATEGY_CODEGEN_PROVIDER_POOL=apihost_claude_opus47,deepseek_official
# AI_COMMITTEE_FINAL_CHAIRMAN_PROVIDER_POOL=apihost_claude_opus47

# ========== 共享 API Key 示例 ==========
# 多个 OpenRouter provider 可通过 AI_PROVIDER_<ID>_API_KEY_ENV 复用同一个 OPENROUTER_API_KEY。
OPENROUTER_API_KEY=你的OpenRouter_API_Key

# ========== Provider: OpenRouter Sonar Pro 搜索 ==========
AI_PROVIDER_OPENROUTER_SONAR_PRO_ENABLED=true
AI_PROVIDER_OPENROUTER_SONAR_PRO_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_OPENROUTER_SONAR_PRO_API_KEY_ENV=OPENROUTER_API_KEY
AI_PROVIDER_OPENROUTER_SONAR_PRO_MODEL=perplexity/sonar-pro
AI_PROVIDER_OPENROUTER_SONAR_PRO_TYPE=openai_compatible_search
AI_PROVIDER_OPENROUTER_SONAR_PRO_ROLE=market_search,committee,advisor
AI_PROVIDER_OPENROUTER_SONAR_PRO_PRIORITY_MARKET_SEARCH=10
AI_PROVIDER_OPENROUTER_SONAR_PRO_PRIORITY_COMMITTEE=20
AI_PROVIDER_OPENROUTER_SONAR_PRO_PRIORITY_ADVISOR=30

# ========== Provider: apihost claude opus 4.7 ==========
AI_PROVIDER_APIHOST_CLAUDE_OPUS47_ENABLED=true
AI_PROVIDER_APIHOST_CLAUDE_OPUS47_BASE_URL=https://apihost.cn/v1
AI_PROVIDER_APIHOST_CLAUDE_OPUS47_API_KEY=你的key
AI_PROVIDER_APIHOST_CLAUDE_OPUS47_MODEL=claude-opus-4-7
AI_PROVIDER_APIHOST_CLAUDE_OPUS47_TYPE=openai_compatible
AI_PROVIDER_APIHOST_CLAUDE_OPUS47_ROLE=advisor,codegen,chairman
AI_PROVIDER_APIHOST_CLAUDE_OPUS47_PRIORITY_ADVISOR=10
AI_PROVIDER_APIHOST_CLAUDE_OPUS47_PRIORITY_CODEGEN=10
AI_PROVIDER_APIHOST_CLAUDE_OPUS47_PRIORITY_CHAIRMAN=10

# ========== Provider: apihost claude opus 4.6 ==========
AI_PROVIDER_APIHOST_CLAUDE_OPUS46_ENABLED=true
AI_PROVIDER_APIHOST_CLAUDE_OPUS46_BASE_URL=https://apihost.cn/v1
AI_PROVIDER_APIHOST_CLAUDE_OPUS46_API_KEY=你的key
AI_PROVIDER_APIHOST_CLAUDE_OPUS46_MODEL=claude-opus-4-6
AI_PROVIDER_APIHOST_CLAUDE_OPUS46_TYPE=openai_compatible
AI_PROVIDER_APIHOST_CLAUDE_OPUS46_ROLE=advisor,codegen
AI_PROVIDER_APIHOST_CLAUDE_OPUS46_PRIORITY_ADVISOR=20
AI_PROVIDER_APIHOST_CLAUDE_OPUS46_PRIORITY_CODEGEN=20

# ========== Provider: DeepSeek 官方 ==========
AI_PROVIDER_DEEPSEEK_OFFICIAL_ENABLED=false
AI_PROVIDER_DEEPSEEK_OFFICIAL_BASE_URL=你的deepseek_base_url
AI_PROVIDER_DEEPSEEK_OFFICIAL_API_KEY=你的deepseek_key
AI_PROVIDER_DEEPSEEK_OFFICIAL_MODEL=你的deepseek模型名
AI_PROVIDER_DEEPSEEK_OFFICIAL_TYPE=openai_compatible
AI_PROVIDER_DEEPSEEK_OFFICIAL_ROLE=committee,advisor,codegen
AI_PROVIDER_DEEPSEEK_OFFICIAL_PRIORITY_COMMITTEE=10
AI_PROVIDER_DEEPSEEK_OFFICIAL_PRIORITY_ADVISOR=40
AI_PROVIDER_DEEPSEEK_OFFICIAL_PRIORITY_CODEGEN=40

# ========== Provider: GLM / 智谱官方 ==========
AI_PROVIDER_GLM_OFFICIAL_ENABLED=false
AI_PROVIDER_GLM_OFFICIAL_BASE_URL=你的glm_base_url
AI_PROVIDER_GLM_OFFICIAL_API_KEY=你的glm_key
AI_PROVIDER_GLM_OFFICIAL_MODEL=你的glm模型名
AI_PROVIDER_GLM_OFFICIAL_TYPE=openai_compatible
AI_PROVIDER_GLM_OFFICIAL_ROLE=committee,advisor,codegen
AI_PROVIDER_GLM_OFFICIAL_PRIORITY_COMMITTEE=30
AI_PROVIDER_GLM_OFFICIAL_PRIORITY_ADVISOR=50
AI_PROVIDER_GLM_OFFICIAL_PRIORITY_CODEGEN=50

# Concurrent AI investment committee
AI_COMMITTEE_PARALLEL_ENABLED=true
AI_COMMITTEE_ROLE_COUNT=6
AI_COMMITTEE_MAX_PARALLEL_CALLS=6
AI_COMMITTEE_ROLE_TIMEOUT_SECONDS=180
AI_COMMITTEE_MIN_SUCCESSFUL_ROLES=3
AI_COMMITTEE_FINAL_CHAIRMAN_PROVIDER=GS88_GPT55

# Concurrent codegen committee and reviewer
CODEGEN_COMMITTEE_ENABLED=true
CODEGEN_COMMITTEE_CANDIDATE_COUNT=3
CODEGEN_COMMITTEE_MAX_PARALLEL_CALLS=3
CODEGEN_COMMITTEE_TIMEOUT_SECONDS=240
CODEGEN_REVIEWER_ENABLED=true
CODEGEN_REVIEWER_PROVIDER_POOL=GS88_GPT55,GS88_GPT54,GS88_CODEX_AUTO_REVIEW,OPENROUTER_GPT53C

# Recovery after too few trades / near zero trades
TOO_FEW_TRADES_RECOVERY_ENABLED=true
TOO_FEW_TRADES_RECOVERY_MIN_TRADES=20
